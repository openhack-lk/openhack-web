---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';

const GITHUB_URL = 'https://github.com/openhack-lk/openhack-web';
---

<Layout
  title="About - openhack.lk"
  description="openhack.lk is an open-source, community-curated directory of hackathons happening across Sri Lanka."
>
  <div class="relative overflow-hidden border-b border-border">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-2xl px-4 py-20 sm:px-6 lg:px-8">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
        About the project
      </span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-text sm:text-5xl">What is this?</h1>
    </div>
  </div>

  <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="space-y-5 text-base leading-relaxed text-text-muted">
      <p>
        <strong class="text-text">openhack.lk</strong> is a directory - nothing more. Sri Lankan university hackathons
        are scattered across Instagram posts, WhatsApp forwards and half-updated Linktrees. This site pulls them
        into one place so students can find out what's happening without digging through five different group chats.
      </p>
      <p>
        We don't handle registration, payments, or judging. Every listing links straight to the organizer's own
        site - that's where the actual sign-up happens. We're just the index.
      </p>
      <p>
        The project is open-source and community-curated. Listings are currently seeded by hand while the
        submission dashboard is being built; soon, organizers will be able to submit their own hackathon for
        approval directly.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface px-5 py-3 text-sm font-semibold text-text transition-colors hover:border-accent-500/40"
      >
        <Icon name="github" class="h-4 w-4" />
        View the source on GitHub
      </a>
      <a
        href={withBase('/')}
        class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-600"
      >
        Browse hackathons
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</Layout>
