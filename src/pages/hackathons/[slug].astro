---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Badge from '../../components/Badge.astro';
import Icon from '../../components/Icon.astro';
import HackathonCard from '../../components/HackathonCard.astro';
import { formatDateRange } from '../../lib/dates';
import { getUniversityIdentity } from '../../lib/universities';
import { getPartnerIdentity } from '../../lib/partners';
import { sortForListing } from '../../lib/hackathons';

export async function getStaticPaths() {
  const entries = await getCollection('hackathons');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const {
  title,
  organizerName,
  organizerUniversity,
  description,
  bannerImage,
  externalUrl,
  startDate,
  endDate,
  mode,
  location,
  whoCanParticipate,
  partners,
  duration,
  phases,
  tags,
  status,
} = entry.data;

const identity = getUniversityIdentity(organizerUniversity);
const themeColor = entry.data.themeColor ?? identity.color;

const allEntries = await getCollection('hackathons');
const moreHackathons = sortForListing(
  allEntries.filter((e) => e.data.slug !== entry.data.slug && e.data.status === 'upcoming'),
).slice(0, 3);
---

<Layout title={`${title} - openhack.lk`} description={description} ogImage={bannerImage ?? '/og-default.png'}>
  <article style={`--uni: ${themeColor}`}>
    <div class="relative aspect-[16/9] w-full overflow-hidden sm:aspect-[3/1]">
      {
        bannerImage ? (
          <img src={bannerImage} alt={title} class="h-full w-full object-cover" />
        ) : (
          <div class="relative flex h-full w-full items-center justify-center bg-[linear-gradient(160deg,color-mix(in_srgb,var(--uni)_88%,black_8%),color-mix(in_srgb,var(--uni)_28%,black_78%))]">
            <div class="bg-grid absolute inset-0 opacity-40" />
            <span class="relative flex h-20 w-20 items-center justify-center rounded-2xl bg-white/10 font-mono text-lg font-bold text-white/90 ring-1 ring-white/20 backdrop-blur-sm">
              {identity.shortCode.slice(0, 4)}
            </span>
          </div>
        )
      }
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-black/10" />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-transparent" />

      <div class="absolute inset-x-0 top-0 pt-4 sm:pt-6">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 rounded-full bg-black/40 px-3 py-1.5 text-xs font-medium text-white/90 ring-1 ring-white/15 backdrop-blur-sm transition-colors hover:bg-black/55"
          >
            <Icon name="arrow-right" class="h-3.5 w-3.5 rotate-180" />
            All hackathons
          </a>
        </div>
      </div>

      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-4xl px-4 pb-6 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-center gap-2">
            <Badge kind="status" value={status} />
            <Badge kind="mode" value={mode} />
          </div>
          <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">{title}</h1>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-6 border-b border-border pb-6">
        <div class="flex items-center gap-3">
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xs font-bold text-white shadow-sm ring-4 ring-bg"
            style="background:var(--uni)"
          >
            {identity.shortCode.slice(0, 4)}
          </div>
          <div>
            <p class="font-medium text-text">{organizerName}</p>
            <p class="text-sm" style={`color: color-mix(in srgb, var(--uni) 65%, var(--color-text-muted))`}>
              {organizerUniversity}
            </p>
          </div>
        </div>

        <div class="flex flex-col items-end gap-1 text-sm">
          <p class="flex items-center gap-1.5 font-medium text-text">
            <Icon name="calendar" class="h-3.5 w-3.5 text-text-muted" />
            {formatDateRange(startDate, endDate)}
            {duration && phases.length === 0 && <span class="text-text-muted"> &middot; {duration}</span>}
          </p>
          {
            location && (
              <p class="flex items-center gap-1.5 text-text-muted">
                <Icon name="pin" class="h-3.5 w-3.5" />
                {location}
              </p>
            )
          }
        </div>
      </div>

      {
        partners.length > 0 && (
          <div class="flex flex-wrap items-center gap-2.5 border-b border-border py-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">In partnership with</span>
            {partners.map((partner) => {
              const p = getPartnerIdentity(partner);
              return (
                <span class="flex items-center gap-1.5 rounded-full border border-border py-1 pl-1 pr-2.5 text-xs font-medium text-text">
                  <span
                    class="flex h-5 w-5 items-center justify-center rounded-full text-[0.55rem] font-bold text-white"
                    style={`background:${p.color}`}
                  >
                    {p.shortCode.slice(0, 1)}
                  </span>
                  {partner}
                </span>
              );
            })}
          </div>
        )
      }

      <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="text-base leading-relaxed text-text-muted">{description}</p>

          {
            phases.length > 0 && (
              <div class="mt-6">
                <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">
                  Format &middot; {phases.length} stages
                </p>
                <ol>
                  {phases.map((phase, i) => (
                    <li class="relative flex gap-4 pb-6 last:pb-0">
                      {i < phases.length - 1 && <span class="absolute left-[9px] top-5 -bottom-1 w-px bg-border" />}
                      <span
                        class="relative z-10 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[0.6rem] font-bold text-white"
                        style="background:var(--uni)"
                      >
                        {i + 1}
                      </span>
                      <div>
                        <p class="text-sm font-semibold text-text">{phase.name}</p>
                        <p class="mt-0.5 text-xs text-text-muted">
                          {phase.when}
                          {phase.duration && <> &middot; {phase.duration}</>}
                        </p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }

          {
            whoCanParticipate && (
              <div class="glass mt-6 flex items-start gap-3 rounded-xl px-4 py-3.5">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-500/10 text-accent-600 dark:text-accent-400">
                  <Icon name="users" class="h-3.5 w-3.5" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Who can participate</p>
                  <p class="mt-1 text-sm leading-relaxed text-text">{whoCanParticipate}</p>
                </div>
              </div>
            )
          }

          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <Badge kind="tag" value={tag} />
                ))}
              </div>
            )
          }
        </div>

        <div class="flex flex-col justify-start gap-3 lg:w-64">
          <a
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex items-center justify-center gap-2 overflow-hidden rounded-xl bg-accent-500 px-6 py-4 text-center text-base font-semibold text-white shadow-lg shadow-accent-500/25 transition-all hover:shadow-xl hover:shadow-accent-500/35"
          >
            <span
              class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/15 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
            />
            <span class="relative">Visit official site</span>
            <Icon name="arrow-right" class="relative h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>
          <p class="text-center text-xs text-text-muted">
            Registration, rules and updates all happen on the organizer's site.
          </p>
        </div>
      </div>
    </div>

    {
      moreHackathons.length > 0 && (
        <div class="border-t border-border">
          <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
            <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-text-muted">More hackathons</p>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {moreHackathons.map((e) => (
                <HackathonCard entry={e} />
              ))}
            </div>
          </div>
        </div>
      )
    }
  </article>
</Layout>
