---
import Icon from './Icon.astro';

const GITHUB_URL = 'https://github.com/openhack-lk/openhack-web';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-3 z-30 px-3 sm:px-6 lg:px-8">
  <div class="glass mx-auto flex max-w-3xl items-center justify-between rounded-full px-3 py-2 shadow-lg shadow-black/5">
    <a href="/" class="group flex items-center gap-2 pl-1.5">
      <span class="relative flex h-7 w-7 items-center justify-center">
        <span
          class="absolute inset-0 rounded-full bg-accent-500/25 opacity-0 blur-md transition-opacity duration-300 group-hover:opacity-100"
        ></span>
        <img src="/openhack.webp" alt="openhack.lk" width="28" height="28" class="relative h-7 w-7" />
      </span>
      <span class="font-mono text-[0.95rem] font-bold tracking-tight text-text">
        openhack<span class="text-accent-500">.lk</span>
      </span>
    </a>

    <nav class="flex items-center gap-1">
      <div class="mr-1 hidden items-center gap-0.5 rounded-full bg-black/[0.03] p-0.5 dark:bg-white/5 sm:flex">
        {
          navLinks.map((link) => {
            const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
                  isActive ? 'bg-bg text-text shadow-sm' : 'text-text-muted hover:text-text',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </div>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-full bg-text px-3.5 py-2 text-sm font-medium text-bg transition-opacity hover:opacity-85"
      >
        <Icon name="github" class="h-3.5 w-3.5" />
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </nav>
  </div>
</header>
