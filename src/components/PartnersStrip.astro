---
import { getFeaturedPartners } from '../lib/partners';

const partners = getFeaturedPartners();
---

<section class="border-b border-border py-8">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-semibold uppercase tracking-wider text-text-muted">
      Also organized with student chapters and industry partners
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      {
        partners.map((p) => (
          <span class="flex items-center gap-2 text-sm font-medium text-text-muted">
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full text-[0.6rem] font-bold text-white"
              style={`background:${p.color}`}
            >
              {p.shortCode.slice(0, 1)}
            </span>
            {p.name}
          </span>
        ))
      }
    </div>
  </div>
</section>
