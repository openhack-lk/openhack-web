---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { formatDateRange } from '../lib/dates';
import { getUniversityIdentity } from '../lib/universities';
import { withBase } from '../lib/paths';

interface Props {
  entry: CollectionEntry<'hackathons'>;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, organizerName, organizerUniversity, startDate, endDate, mode, tags, status, bannerImage, duration, phases } =
  entry.data;

const identity = getUniversityIdentity(organizerUniversity);
const themeColor = entry.data.themeColor ?? identity.color;
---

<a
  href={withBase(`/hackathons/${entry.data.slug}/`)}
  style={`--uni: ${themeColor}`}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-surface transition-colors duration-200 hover:border-text/20"
>
  <div class="relative aspect-[16/9] w-full overflow-hidden bg-surface-hover">
    {
      bannerImage ? (
        <img
          src={withBase(bannerImage)}
          alt={title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="relative flex h-full w-full items-center justify-center" style="background:var(--uni)">
          <span
            class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-white/10 font-mono text-sm font-bold text-white/90 ring-1 ring-white/20"
          >
            {identity.shortCode.slice(0, 4)}
          </span>
        </div>
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent" />

    {
      featured && (
        <span class="absolute left-3 top-3 flex items-center gap-1 rounded-full bg-black/55 px-2.5 py-1 text-xs font-semibold text-white ring-1 ring-white/20 backdrop-blur-sm">
          <svg viewBox="0 0 20 20" class="h-3 w-3 fill-current">
            <path d="M10 1.5l2.5 5.7 6.2.6-4.7 4.1 1.4 6.1L10 14.9l-5.4 3.1 1.4-6.1L1.3 7.8l6.2-.6L10 1.5z" />
          </svg>
          Featured
        </span>
      )
    }

    <div class="absolute bottom-3 left-3 flex items-center gap-2">
      <Badge kind="status" value={status} />
      <Badge kind="mode" value={mode} />
    </div>
  </div>

  <div class:list={['relative flex flex-1 flex-col gap-3', featured ? 'p-5 pt-6' : 'p-4 pt-6']}>
    <div
      class="absolute -top-5 left-4 flex h-10 w-10 items-center justify-center rounded-xl text-[0.6rem] font-bold text-white shadow-md ring-4 ring-surface"
      style="background:var(--uni)"
      title={organizerUniversity}
    >
      {identity.shortCode.slice(0, 4)}
    </div>

    <h3 class:list={['font-semibold leading-snug text-text', featured ? 'text-xl' : 'text-lg']}>{title}</h3>

    <p class="-mt-1 text-sm text-text-muted">
      {organizerName} ·{' '}
      <span style={`color: color-mix(in srgb, var(--uni) 65%, currentColor)`}>{organizerUniversity}</span>
    </p>

    <div class="mt-auto flex items-center gap-1.5 text-sm font-medium text-text-muted">
      <Icon name="calendar" class="h-3.5 w-3.5" />
      {formatDateRange(startDate, endDate)}
      {phases.length > 0 && <span> &middot; {phases.length} stages</span>}
      {phases.length === 0 && duration && <span> &middot; {duration}</span>}
    </div>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {tags.slice(0, 2).map((tag) => (
            <Badge kind="tag" value={tag} />
          ))}
        </div>
      )
    }
  </div>
</a>
