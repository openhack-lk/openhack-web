---
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';

const GITHUB_URL = 'https://github.com/openhack-lk/openhack-web';
---

<footer class="relative overflow-hidden border-t border-border">
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>

  <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <a href={withBase('/')} class="flex items-center gap-2">
          <img src={withBase('/openhack.webp')} alt="" width="24" height="24" class="h-6 w-6" />
          <span class="font-mono text-sm font-bold text-text">
            openhack<span class="text-accent-500">.lk</span>
          </span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text-muted">
          A community-curated, open-source directory of hackathons happening across Sri Lanka. We don't run
          registrations - we just point you to the organizer's own site.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Project</p>
        <ul class="mt-3 space-y-2.5 text-sm">
          <li>
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-text-muted transition-colors hover:text-text"
            >
              <Icon name="github" class="h-3.5 w-3.5" />
              Star us on GitHub
            </a>
          </li>
          <li>
            <a href={withBase('/about/')} class="text-text-muted transition-colors hover:text-text">
              What is this?
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Organize a hackathon?</p>
        <p class="mt-3 text-sm text-text-muted">Get it listed here for free.</p>
        <a
          href={withBase('/submit/')}
          class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400"
        >
          Submit your hackathon
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>

    <p class="mt-12 border-t border-border pt-6 text-xs text-text-muted">
      Built by students, for students. Not affiliated with any single university.
    </p>
  </div>
</footer>
