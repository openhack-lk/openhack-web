---
import Icon, { type IconName } from './Icon.astro';

interface Tile {
  icon: IconName;
  color: string;
  top: string;
  left: string;
  size: number;
  rotate: number;
  drift: 'a' | 'b' | 'c' | 'd';
  duration: number;
  delay: number;
}

const tiles: Tile[] = [
  { icon: 'laptop', color: '#fc6b14', top: '8%', left: '6%', size: 92, rotate: -8, drift: 'a', duration: 22, delay: -3 },
  { icon: 'users', color: '#7a1f2e', top: '62%', left: '4%', size: 78, rotate: 6, drift: 'b', duration: 26, delay: -9 },
  { icon: 'lightbulb', color: '#1d4ed8', top: '4%', left: '82%', size: 84, rotate: 7, drift: 'c', duration: 24, delay: -6 },
  { icon: 'trophy', color: '#4338ca', top: '70%', left: '88%', size: 96, rotate: -6, drift: 'd', duration: 28, delay: -14 },
  { icon: 'sparkles', color: '#15803d', top: '18%', left: '92%', size: 64, rotate: -4, drift: 'b', duration: 20, delay: -4 },
  { icon: 'rocket', color: '#c2410c', top: '80%', left: '20%', size: 72, rotate: 5, drift: 'a', duration: 25, delay: -11 },
  { icon: 'code', color: '#fc6b14', top: '86%', left: '55%', size: 66, rotate: -5, drift: 'c', duration: 21, delay: -8 },
];
---

<div class="pointer-events-none absolute inset-0 hidden overflow-hidden sm:block" aria-hidden="true">
  {
    tiles.map((tile) => (
      <div
        class:list={['drift-tile', `drift-${tile.drift}`]}
        style={`--size:${tile.size}px; --rot:${tile.rotate}deg; --tile-color:${tile.color}; top:${tile.top}; left:${tile.left}; animation-duration:${tile.duration}s; animation-delay:${tile.delay}s;`}
      >
        <div class="flex h-full w-full items-center justify-center rounded-2xl border border-white/10 shadow-xl backdrop-blur-sm">
          <Icon name={tile.icon} class="h-[38%] w-[38%]" />
        </div>
      </div>
    ))
  }
</div>

<style>
  .drift-tile {
    position: absolute;
    width: var(--size);
    height: var(--size);
    transform: rotate(var(--rot));
    animation-name: drift-a;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    opacity: 0.5;
  }

  .drift-tile > div {
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--tile-color) 55%, transparent),
      color-mix(in srgb, var(--tile-color) 12%, transparent)
    );
    color: color-mix(in srgb, var(--tile-color) 70%, white 30%);
  }

  .drift-a {
    animation-name: drift-a;
  }
  .drift-b {
    animation-name: drift-b;
  }
  .drift-c {
    animation-name: drift-c;
  }
  .drift-d {
    animation-name: drift-d;
  }

  @keyframes drift-a {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot));
    }
    50% {
      transform: translate(18px, -22px) rotate(calc(var(--rot) * -1));
    }
  }
  @keyframes drift-b {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot));
    }
    50% {
      transform: translate(-20px, 16px) rotate(calc(var(--rot) + 10deg));
    }
  }
  @keyframes drift-c {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot));
    }
    50% {
      transform: translate(16px, 20px) rotate(calc(var(--rot) - 8deg));
    }
  }
  @keyframes drift-d {
    0%,
    100% {
      transform: translate(0, 0) rotate(var(--rot));
    }
    50% {
      transform: translate(-16px, -18px) rotate(calc(var(--rot) * -1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift-tile {
      animation: none;
    }
  }
</style>
